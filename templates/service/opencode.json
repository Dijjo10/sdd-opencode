{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "planner",
  "instructions": [
    ".docs/specs.md"
  ],
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "planner": {
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "ls *": "allow",
          "cat *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "git status": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        },
        "task": {
          "*": "deny",
          "code-reviewer": "allow",
          "security-reviewer": "allow"
        }
      },
      "tools": {
        "write": true,
        "edit": true,
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "skill": true,
        "task": true
      }
    },
    "builder": {
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "ls *": "allow",
          "cat *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "mkdir *": "allow",
          "touch *": "allow",
          "cp *": "allow",
          "mv *": "allow",
          "git status": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git add *": "allow",
          "git restore *": "allow",
          "git commit -m *": "allow",
          "git commit*": "ask",
          "git push*": "ask",
          "git reset*": "ask",
          "rm *": "ask",
          "sudo *": "ask",
          "curl *": "ask",
          "wget *": "ask"
        },
        "task": {
          "*": "deny",
          "code-reviewer": "allow",
          "security-reviewer": "allow"
        }
      },
      "tools": {
        "write": true,
        "edit": true,
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "skill": true,
        "task": true
      }
    },
    "code-reviewer": {
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "ls *": "allow",
          "cat *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "git status": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git add *": "allow",
          "git restore *": "allow",
          "git commit*": "deny",
          "git push*": "deny",
          "git reset*": "deny",
          "rm *": "ask",
          "sudo *": "deny",
          "curl *": "deny",
          "wget *": "deny"
        }
      },
      "tools": {
        "write": true,
        "edit": true,
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "skill": true,
        "task": false
      }
    },
    "security-reviewer": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "ls *": "allow",
          "cat *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "git status": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git commit*": "deny",
          "git push*": "deny",
          "rm *": "deny",
          "sudo *": "deny",
          "curl *": "deny",
          "wget *": "deny"
        }
      },
      "tools": {
        "write": true,
        "edit": false,
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "skill": true,
        "task": false
      }
    }
  },
  "mcp": {
    "context7": {
      "enabled": true
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow"
    }
  }
}
