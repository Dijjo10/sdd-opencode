{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "principal",
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "principal": {
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "ls *": "allow",
          "cat *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "mkdir *": "allow",
          "touch *": "allow",
          "cp *": "allow",
          "mv *": "allow",
          "git status": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git add *": "allow",
          "git restore *": "allow",
          "git commit -m *": "allow",
          "git commit*": "ask",
          "git push*": "ask",
          "git reset*": "ask",
          "rm *": "ask",
          "sudo *": "ask",
          "curl *": "ask",
          "wget *": "ask",
          "docker compose config": "allow",
          "yamllint *": "allow",
          "shellcheck *": "allow"
        }
      },
      "tools": {
        "write": true,
        "edit": true,
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "skill": true,
        "task": false
      }
    }
  },
  "mcp": {
    "context7": {
      "enabled": true
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow"
    }
  }
}
