{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "principal",
  "permissions": [
    {
      "action": "shell",
      "resource": "*git push*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*gh pr merge*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*gh release*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*git reset --hard*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*git clean*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*sudo *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*git push*--force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*git push*-f *",
      "effect": "deny"
    }
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "principal": {
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  }
}
