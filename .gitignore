# ============================================================================
# OpenCode runtime artifacts
# ============================================================================
# Files and directories auto-generated by OpenCode at runtime when launched
# inside a project directory. These are not part of the pattern and must not
# be committed.

# Node/Bun runtime that OpenCode may create in the current directory
node_modules/
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lock
bun.lockb

# OpenCode personal overrides — local settings that shouldn't be shared
.opencode/settings.local.json
.opencode/cache/
.opencode-cache/

# OpenCode session data if written locally
.opencode/sessions/
.opencode/logs/

# ============================================================================
# Editor / IDE clutter
# ============================================================================
.idea/
.vscode/
*.swp
*.swo
*~

# ============================================================================
# OS clutter
# ============================================================================
.DS_Store
Thumbs.db

# ============================================================================
# Logs
# ============================================================================
*.log
logs/

# ============================================================================
# NOTE
# ============================================================================
# This .gitignore covers the artifacts the SDD pattern itself may produce or
# encounter. When you adopt this pattern in a real project, extend it with
# your stack-specific ignores (build outputs, compiled binaries, coverage
# reports, local env files, etc.).
