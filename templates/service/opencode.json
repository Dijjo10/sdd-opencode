{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "planner",
  "instructions": [
    ".docs/specs.md"
  ],
  "permissions": [
    {
      "action": "shell",
      "resource": "*git push*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*git merge *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*gh pr merge*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*gh release*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*git reset --hard*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*git clean*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*sudo *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*git push*--force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*git push*-f *",
      "effect": "deny"
    }
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "planner": {
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "edit",
          "resource": "*.docs/*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*.md",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "code-reviewer",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "security-reviewer",
          "effect": "allow"
        }
      ]
    },
    "builder": {
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "code-reviewer",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "security-reviewer",
          "effect": "allow"
        }
      ]
    },
    "code-reviewer": {
      "permissions": [
        {
          "action": "shell",
          "resource": "*git commit*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*git push*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*git reset*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*git merge *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*gh pr merge*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "security-reviewer": {
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*.docs/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*git commit*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*git push*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*git reset*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*git merge *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*gh pr merge*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false
      }
    }
  }
}
